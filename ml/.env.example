# OCI model artifact download is disabled by default.
# Copy this file to `.env` or export these variables in your shell before running Docker Compose.

OCI_MODEL_DOWNLOAD_ENABLED=false
OCI_MODEL_FORCE_DOWNLOAD=false

# Inside the container, Docker Compose mounts OCI_CONFIG_DIR to /root/.oci.
OCI_CONFIG_DIR=./ml/.oci
OCI_CONFIG_FILE=/root/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Fill these with non-secret OCI Object Storage identifiers for your environment.
OCI_NAMESPACE=
OCI_BUCKET_NAME=financial-models

# Object names expected by the Data Science PR.
OCI_FINANCIAL_STABILITY_OBJECT=financial-modelsmodelo_financial_stability.pkl
OCI_TRANSACTION_CLASSIFIER_OBJECT=financial-modelsrandom_forest_model (champion).pkl
OCI_LABEL_ENCODER_CATEGORIA_OBJECT=financial-modelslabel_encoder_categoria.pkl
OCI_SCALER_CATEGORIA_OBJECT=financial-modelsscaler_categoria.pkl
